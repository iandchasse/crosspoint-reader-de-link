+size_t RuntimeFontConverter::countGlyphs(const EpdFont* font) {
+  if (!font || !font->data) return 0;
+  // Sum glyph counts from all intervals
+  size_t total = 0;
+  for (uint32_t i = 0; i < font->data->intervalCount; ++i) {
